{
  "name": "focus-diff",
  "private": true,
  "description": "Review what matters: the Focus Diff browser extension, desktop app and site.",
  "license": "MIT",
  "author": "Hyan Mandian",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "npm run check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "e2e": "npm run e2e --workspaces --if-present"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.19.0",
  "overrides": {
    "fx-runner": {
      "shell-quote": "1.11.0"
    },
    "@focus-diff/app": {
      "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
    },
    "@focus-diff/design-system": {
      "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
    },
    "@focus-diff/desktop": {
      "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
    }
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
