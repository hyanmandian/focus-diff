{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "options": { "typeAware": true, "typeCheck": true },
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "jsdoc", "promise", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "pedantic": "error"
  },
  "env": {
    "es2024": true
  },
  "ignorePatterns": ["coverage/**"],
  "rules": {
    // The same as the Mac app's (apps/desktop/vite.config.ts) and the extension's, less the React and DOM rules.
    // What the categories turn on that doesn't fit: readonly parameters and strict booleans (outside typescript-eslint's strict sets too), JSDoc
    // @param/@returns that would only repeat the types, and size limits on files and functions.
    "typescript/prefer-readonly-parameter-types": "off",
    "typescript/strict-boolean-expressions": "off",
    // Immutable state updates copy with a spread on purpose.
    "oxc/no-map-spread": "off",
    // `void p.then(() => {...})` ends a chain on purpose.
    "promise/always-return": ["error", { "ignoreLastCallback": true }],
    "jsdoc/require-param": "off",
    "jsdoc/require-returns": "off",
    "eslint/max-lines-per-function": "off",
    "eslint/max-lines": "off",
    "import/max-dependencies": "off",
    "eslint/no-inline-comments": "off",
    // A function that returns a value on some paths would need `return undefined;` on the others, which
    // unicorn/no-useless-undefined forbids.
    "typescript/consistent-return": "off",
    // "" means missing in the reader's settings and GitHub's fields (x?.trim() || null).
    "typescript/prefer-nullish-coalescing": ["error", { "ignorePrimitives": { "string": true } }],
    // Stylesheets are imported for what they do.
    "import/no-unassigned-import": ["error", { "allow": ["**/*.css"] }],
    // No barrels, no cycles, nothing unused.
    "import/no-cycle": "error",
    "import/no-self-import": "error",
    "import/no-duplicates": "error",
    "import/no-namespace": "error",
    "eslint/no-unused-vars": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "off",
    "typescript/consistent-type-imports": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "jsdoc/check-tag-names": "error",
    "jsdoc/no-defaults": "error",
    "unicorn/filename-case": ["error", { "case": "kebabCase" }],
    "unicorn/no-null": "off",
    "eslint/no-console": ["error", { "allow": ["error"] }],
    "eslint/eqeqeq": "error",
    "eslint/no-var": "error",
    "eslint/prefer-const": "error"
  },
  "overrides": [
    {
      "files": ["src/**/*.test.ts"],
      "rules": {
        "vitest/no-conditional-in-test": "off",
        "unicorn/consistent-function-scoping": "off",
        "eslint/prefer-promise-reject-errors": "off",
        "typescript/prefer-promise-reject-errors": "off"
      }
    }
  ]
}
