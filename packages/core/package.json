{
  "name": "@focus-diff/core",
  "version": "0.0.0",
  "private": true,
  "description": "Focus Diff's logic shared by the browser extension and the desktop app: pure TypeScript, no runtime dependencies.",
  "license": "MIT",
  "author": "Hyan Mandian",
  "type": "module",
  "exports": {
    "./active-time": "./src/active-time/active-time.ts",
    "./duration": "./src/duration/duration.ts",
    "./estimate": "./src/estimate/estimate.ts",
    "./filters": "./src/filters/filters.ts",
    "./github-pulls": "./src/github-pulls/github-pulls.ts",
    "./json-decode": "./src/json-decode/json-decode.ts",
    "./queue-config": "./src/queue-config/queue-config.ts",
    "./queue-engine": "./src/queue-engine/queue-engine.ts",
    "./queue-items": "./src/queue-items/queue-items.ts",
    "./queue-panel": "./src/queue-panel/queue-panel.ts",
    "./queue-watch": "./src/queue-watch/queue-watch.ts",
    "./queue-words": "./src/queue-words/queue-words.ts",
    "./recipes": "./src/recipes/recipes.ts",
    "./repos": "./src/repos/repos.ts"
  },
  "scripts": {
    "check": "tsc --noEmit && oxlint && oxfmt --check && vitest run --coverage",
    "fmt": "oxfmt",
    "lint": "oxlint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.5",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
