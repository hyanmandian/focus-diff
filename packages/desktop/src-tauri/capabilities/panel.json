{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "panel",
  "description": "The menu bar panel: its queues, signing in, opening a pull request, updates and quitting.",
  "windows": [
    "panel"
  ],
  "permissions": [
    "core:app:allow-version",
    "allow-auth-device-cancel",
    "allow-auth-device-finish",
    "allow-auth-device-start",
    "allow-auth-use-gh",
    "allow-auth-use-token",
    "allow-clear-arrival",
    "allow-confirm",
    "allow-dismiss",
    "allow-drafts-flush",
    "allow-drafts-forget",
    "allow-drafts-put",
    "allow-drafts-remove",
    "allow-drafts-retry",
    "allow-drafts-state",
    "allow-end-review",
    "allow-hide-panel",
    "allow-install-update",
    "allow-kept-read",
    "allow-kept-write",
    "allow-mark-queue-seen",
    "allow-mark-seen",
    "allow-open-panel",
    "allow-open-review",
    "allow-open-settings",
    "allow-quit",
    "allow-refresh",
    "allow-restore",
    "allow-snapshot",
    "allow-take-link",
    "allow-update-offered"
  ]
}
