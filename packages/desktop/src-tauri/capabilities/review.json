{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "review",
  "description": "A pull request window: reading and writing on GitHub, drafts, files marked viewed, the AI and actions, and moving to the next pull request.",
  "windows": [
    "review-*"
  ],
  "permissions": [
    "core:event:allow-emit-to",
    "allow-ai-ask",
    "allow-ai-cancel",
    "allow-ai-prepare",
    "allow-ai-statuses",
    "allow-clear-arrival",
    "allow-confirm",
    "allow-dismiss",
    "allow-drafts-flush",
    "allow-drafts-forget",
    "allow-drafts-put",
    "allow-drafts-remove",
    "allow-drafts-retry",
    "allow-drafts-state",
    "allow-github-file",
    "allow-github-web-session",
    "allow-kept-read",
    "allow-kept-write",
    "allow-mark-queue-seen",
    "allow-mark-seen",
    "allow-menu-state",
    "allow-open-settings",
    "allow-queue-viewed",
    "allow-queued-viewed",
    "allow-quit",
    "allow-refresh",
    "allow-restore",
    "allow-reviewed",
    "allow-run-action",
    "allow-sign-in-web",
    "allow-snapshot",
    "allow-spare-ready",
    "allow-switch-review",
    "allow-upload-attachment"
  ]
}
