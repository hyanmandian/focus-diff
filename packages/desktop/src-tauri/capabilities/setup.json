{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "setup",
  "description": "First-run setup: signing in, opening the panel when done, and closing itself.",
  "windows": [
    "setup"
  ],
  "permissions": [
    "core:window:allow-close",
    "allow-ai-ask",
    "allow-ai-statuses",
    "allow-auth-device-cancel",
    "allow-auth-device-finish",
    "allow-auth-device-start",
    "allow-auth-use-gh",
    "allow-auth-use-token",
    "allow-open-panel",
    "allow-report-problem"
  ]
}
