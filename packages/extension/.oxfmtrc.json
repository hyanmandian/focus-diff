{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "sortImports": true,
  "sortPackageJson": true,
  "ignorePatterns": [
    ".output/**",
    ".wxt/**",
    "store/**",
    "tests/fixtures/**",
    "playwright-report/**",
    "test-results/**",
    "coverage/**",
    "package-lock.json",
    "CHANGELOG.md"
  ]
}
