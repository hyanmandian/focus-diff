{
  "name": "@focus-diff/extension",
  "version": "1.2.0",
  "private": true,
  "description": "Review what matters: the Focus Diff browser extension, running the app's screens, with filters on GitHub's diffs.",
  "license": "MIT",
  "author": "Hyan Mandian",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:safari": "wxt build -b safari",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip:safari": "wxt zip -b safari",
    "screenshots": "wxt build && node scripts/screenshots.ts",
    "compile": "tsc --noEmit",
    "lint": "oxlint",
    "lint:firefox": "wxt build -b firefox && web-ext lint --source-dir .output/firefox-mv3 --self-hosted",
    "fmt": "oxfmt",
    "check": "tsc --noEmit && oxlint && oxfmt --check && jscpd && npm run check:dependencies && npm run check:lockfile && npm run check:unused",
    "test": "vitest run",
    "e2e": "wxt build && playwright test",
    "postinstall": "wxt prepare",
    "duplicates": "jscpd",
    "check:dependencies": "node -e \"const allowed=['react','react-dom','@pierre/diffs'];const d=Object.keys(require('./package.json').dependencies||{}).filter((n)=>!n.startsWith('@focus-diff/')&&!allowed.includes(n));if(d.length){console.error('Runtime dependencies other than '+allowed.join(', ')+' are not allowed:',d.join(', '));process.exit(1)}\"",
    "check:lockfile": "lockfile-lint --path ../../package-lock.json --type npm --allowed-hosts npm --validate-https --validate-integrity",
    "check:unused": "knip",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@focus-diff/core": "*",
    "@focus-diff/design-system": "*",
    "@focus-diff/desktop": "*",
    "@pierre/diffs": "^1.6.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@babel/core": "^8.0.9",
    "@playwright/test": "^1.63.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/babel__core": "^7.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "@wxt-dev/i18n": "^0.2.7",
    "babel-plugin-react-compiler": "^1.0.0",
    "happy-dom": "^21.0.4",
    "jscpd": "^5.4.0",
    "knip": "^6.39.0",
    "lockfile-lint": "^5.0.1",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.5",
    "web-ext": "^10.7.0",
    "wxt": "^0.21.4"
  },
  "engines": {
    "node": ">=22"
  }
}
