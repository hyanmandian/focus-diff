{
  "manifest_version": 3,
  "name": "Focus Diff",
  "version": "1.0.0",
  "description": "Review what matters: filter GitHub pull request diffs with your own presets and see the real size of what you review.",
  "author": {
    "email": "contact@hyan.com.br"
  },
  "homepage_url": "https://github.com/hyanmandian/focus-diff",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Focus Diff settings"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "shared.js",
        "github.js",
        "panel.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "minimum_chrome_version": "102"
}
