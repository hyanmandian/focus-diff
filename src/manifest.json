{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "1.0.0",
  "default_locale": "en",
  "description": "__MSG_extensionDescription__",
  "author": {
    "email": "contact@hyan.com.br"
  },
  "homepage_url": "https://github.com/hyanmandian/focus-diff",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "__MSG_actionTitle__"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "shared.js",
        "github.js",
        "panel.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "minimum_chrome_version": "102",
  "commands": {
    "next-filter": {
      "suggested_key": {
        "default": "Alt+Shift+Period"
      },
      "description": "__MSG_commandNext__"
    },
    "previous-filter": {
      "suggested_key": {
        "default": "Alt+Shift+Comma"
      },
      "description": "__MSG_commandPrevious__"
    },
    "show-all": {
      "suggested_key": {
        "default": "Alt+Shift+0"
      },
      "description": "__MSG_commandAll__"
    }
  }
}
